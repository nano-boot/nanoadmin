{%- for column in columns %}
{% if column.insertable == 2 %}
        '{{ column.column_name }}',
{% endif %}
{%- endfor %}
    ];

    /**
     * 需要转换的属性类型
     * @var array
     */
    protected $casts = [
{%- for column in columns %}
{% if column.php_type == 'int' or column.php_type == 'integer' %}
        '{{ column.column_name }}' => 'integer',
{% elseif column.php_type == 'float' or column.php_type == 'double' %}
        '{{ column.column_name }}' => 'float',
{% elseif column.php_type == 'bool' or column.php_type == 'boolean' %}
        '{{ column.column_name }}' => 'boolean',
{% endif %}
{%- endfor %}
    ];

    /**
