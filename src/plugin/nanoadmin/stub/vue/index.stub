<template>
  <div class="page-container">
    <!-- 搜索栏 -->
    <TableSearch
      v-model="searchParams"
      @reset="handleReset"
      @search="handleSearch"
    />

    <!-- 表格 -->
    <ArtTable
      v-loading="loading"
      :data="data"
      :columns="columns"
      :pagination="pagination"
      @pagination:size-change="handleSizeChange"
      @pagination:current-change="handleCurrentChange"
    >
      <template #toolbar>
        <ArtButtonTable type="add" @click="handleAdd" />
      </template>
      <template #action="{ row }">
        <el-button type="primary" link @click="handleEdit(row)">编辑</el-button>
        <el-button type="primary" link @click="handleDelete(row)">删除</el-button>
      </template>
    </ArtTable>

    <!-- 编辑弹窗 -->
    <EditDialog
      v-model="dialogVisible"
      :data="currentRow"
      :loading="saveLoading"
      @confirm="handleSave"
      @cancel="dialogVisible = false"
    />
  </div>
</template>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'
import { useTable } from '@/hooks/useTable'
import { useSearchBar } from '@/hooks/useSearchBar'
import { generateTablesApi } from '@/api/{{ namespace }}/{{ lowerClassName }}Api'
import type { Api.{{ namespace }}.{{ className }}Item } from '@/types/api'
import TableSearch from './TableSearch.vue'
import EditDialog from './EditDialog.vue'

const {
  loading,
  data,
  pagination,
  handleSizeChange,
  handleCurrentChange,
  refreshData
} = useTable()

const {
  searchParams,
  handleSearch,
  handleReset
} = useSearchBar({
  keyword: ''
})

const dialogVisible = ref(false)
const saveLoading = ref(false)
const currentRow = ref<Api.{{ namespace }}.{{ className }}Item | null>(null)

const columns = [
  { prop: 'id', label: 'ID', width: 80 },
{%- for column in listColumns %}
  { prop: '{{ column.column_name }}', label: '{{ column.column_comment }}' },
{%- endfor %}
  { prop: 'created_at', label: '创建时间', width: 180 },
  { slot: 'action', label: '操作', width: 180, fixed: 'right' }
]

const handleAdd = () => {
  currentRow.value = null
  dialogVisible.value = true
}

const handleEdit = (row: Api.{{ namespace }}.{{ className }}Item) => {
  currentRow.value = row
  dialogVisible.value = true
}

const handleDelete = async (row: Api.{{ namespace }}.{{ className }}Item) => {
  try {
    await ElMessageBox.confirm('确定删除该记录吗？', '提示', {
      type: 'warning'
    })
    await generateTablesApi.destroy(row.id)
    ElMessage.success('删除成功')
    refreshData()
  } catch (error) {
    if (error !== 'cancel') {
      console.error(error)
    }
  }
}

const handleSave = async (formData: Record<string, any>) => {
  saveLoading.value = true
  try {
    if (currentRow.value) {
      await generateTablesApi.update(currentRow.value.id, formData)
    } else {
      await generateTablesApi.store(formData)
    }
    ElMessage.success('保存成功')
    dialogVisible.value = false
    refreshData()
  } catch (error) {
    console.error(error)
  } finally {
    saveLoading.value = false
  }
}

const fetchData = async () => {
  loading.value = true
  try {
    const result = await generateTablesApi.getPage({
      ...searchParams.value,
      page: pagination.current,
      limit: pagination.size
    })
    data.value = result.records
    pagination.total = result.total
  } catch (error) {
    console.error(error)
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  fetchData()
})
</script>

<style scoped>
.page-container {
  padding: 16px;
}
</style>
